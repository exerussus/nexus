/* Сгенерировано из NexusPalette «Soft Dark» — не править руками.
   Exerussus/Nexus/Dev/Regenerate theme USS. */

.nx-root {
    --nx-bg-hard: #29292E;
    --nx-bg-soft: #36363D;
    --nx-bg-raised: #42424C;
    --nx-text-normal: #DBDBE0;
    --nx-text-dim: #9E9EA8;
    --nx-border: #4C4C57;
    --nx-accent: #669EEB;
    --nx-selection: #424C66;
    --nx-hover: #4C4F5C;
    --nx-pressed: #384054;
    --nx-ok: #4C9E66;
    --nx-warning: #D9B259;
    --nx-error: #D96B66;
    --nx-muted: #666B7A;
    --nx-orphan: #B8753D;
    --nx-surface-hover: #4F4F5C;
    --nx-divider: rgba(255, 255, 255, 0.12);
    --nx-accent-hover: #85B8FF;
    --nx-accent-pressed: #4C7ABD;
    --nx-accent-soft: rgba(102, 158, 235, 0.14);
    --nx-on-accent: #F7FAFF;
    --nx-ok-soft: rgba(76, 158, 102, 0.14);
    --nx-warning-soft: rgba(217, 178, 89, 0.14);
    --nx-error-soft: rgba(217, 107, 102, 0.16);
    --nx-text-faint: #757580;
    --nx-focus: #73A8F5;
    --nx-bg-inset: #222227;
    --nx-accent-text: #8DB8F5;
    --nx-code: #B9D99A;
    --nx-tag-amber: #E3BE6B;
    --nx-tag-amber-soft: #3A3325;
    --nx-tag-green: #7CC99B;
    --nx-tag-green-soft: #26362D;
    --nx-tag-blue: #8DB8F5;
    --nx-tag-blue-soft: #283447;
    --nx-tag-violet: #BBA6EC;
    --nx-tag-violet-soft: #322C45;
    --nx-glow: rgba(102, 158, 235, 0.14);
    --nx-bracket: rgba(0, 0, 0, 0);
    --nx-grid: rgba(0, 0, 0, 0);

    --nx-role-primary-bg: #4C80D9;
    --nx-role-primary-fg: #F5F7FC;
    --nx-role-primary-hover: #6194ED;
    --nx-role-primary-pressed: #3B6EC7;
    --nx-role-primary-border: #70A3FC;
    --nx-role-primary-disabled: #63779B;
    --nx-role-common-bg: #4C4F5C;
    --nx-role-common-fg: #DBDBE0;
    --nx-role-common-hover: #616370;
    --nx-role-common-pressed: #3B3D4A;
    --nx-role-common-border: #707380;
    --nx-role-common-disabled: #494A4F;
    --nx-role-alarm-bg: #C75752;
    --nx-role-alarm-fg: #F5F7FC;
    --nx-role-alarm-hover: #DB6B66;
    --nx-role-alarm-pressed: #B54540;
    --nx-role-alarm-border: #EB7A75;
    --nx-role-alarm-disabled: #926563;
    --nx-role-success-bg: #4C9966;
    --nx-role-success-fg: #F5F7FC;
    --nx-role-success-hover: #61AD7A;
    --nx-role-success-pressed: #3B8754;
    --nx-role-success-border: #70BD8A;
    --nx-role-success-disabled: #64836E;
    --nx-role-warning-bg: #D1A852;
    --nx-role-warning-fg: #1A1A1F;
    --nx-role-warning-hover: #E5BD66;
    --nx-role-warning-pressed: #BF9640;
    --nx-role-warning-border: #F5CC75;
    --nx-role-warning-disabled: #B5A582;
    --nx-role-info-bg: #4C94B2;
    --nx-role-info-fg: #F5F7FC;
    --nx-role-info-hover: #61A8C7;
    --nx-role-info-pressed: #3B82A1;
    --nx-role-info-border: #70B8D6;
    --nx-role-info-disabled: #688490;
    --nx-role-muted-bg: #575966;
    --nx-role-muted-fg: #9E9EA8;
    --nx-role-muted-hover: #6B6E7A;
    --nx-role-muted-pressed: #454754;
    --nx-role-muted-border: #7A7D8A;
    --nx-role-muted-disabled: #54555A;
    --nx-role-ghost-bg: rgba(115, 166, 242, 0);
    --nx-role-ghost-fg: #73A6F2;
    --nx-role-ghost-hover: rgba(115, 166, 242, 0.14);
    --nx-role-ghost-pressed: rgba(115, 166, 242, 0.24);
    --nx-role-ghost-border: #73A6F2;
    --nx-role-ghost-disabled: rgba(115, 166, 242, 0.3);

    --nx-r-s: 4px;
    --nx-r-m: 6px;
    --nx-r-l: 8px;
    --nx-title-spacing: 0px;
}
