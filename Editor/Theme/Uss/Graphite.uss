/* Сгенерировано из NexusPalette «Graphite» — не править руками.
   Exerussus/Nexus/Dev/Regenerate theme USS. */

.nx-root {
    --nx-bg-hard: #1C1F21;
    --nx-bg-soft: #26292E;
    --nx-bg-raised: #33363B;
    --nx-text-normal: #E0E3E6;
    --nx-text-dim: #9499A1;
    --nx-border: #3D4045;
    --nx-accent: #5CBDB2;
    --nx-selection: #335252;
    --nx-hover: #3D4047;
    --nx-pressed: #2B3838;
    --nx-ok: #52A385;
    --nx-warning: #D4AD57;
    --nx-error: #D46666;
    --nx-muted: #5C6169;
    --nx-orphan: #B27342;
    --nx-surface-hover: #40424A;
    --nx-divider: rgba(255, 255, 255, 0.1);
    --nx-accent-hover: #75D6CC;
    --nx-accent-pressed: #3D8F85;
    --nx-accent-soft: rgba(92, 189, 178, 0.14);
    --nx-on-accent: #0D1A1A;
    --nx-ok-soft: rgba(82, 163, 133, 0.14);
    --nx-warning-soft: rgba(212, 173, 87, 0.14);
    --nx-error-soft: rgba(212, 102, 102, 0.16);
    --nx-text-faint: #70757D;
    --nx-focus: #66C7B8;
    --nx-bg-inset: #16181B;
    --nx-accent-text: #7FD6CC;
    --nx-code: #A8D8B9;
    --nx-tag-amber: #D9B061;
    --nx-tag-amber-soft: #30291B;
    --nx-tag-green: #6CC7A0;
    --nx-tag-green-soft: #1E3129;
    --nx-tag-blue: #7FB5D9;
    --nx-tag-blue-soft: #1D2C38;
    --nx-tag-violet: #B49BD6;
    --nx-tag-violet-soft: #2A2536;
    --nx-glow: rgba(92, 189, 178, 0.16);
    --nx-bracket: rgba(0, 0, 0, 0);
    --nx-grid: rgba(255, 255, 255, 0.014);

    --nx-role-primary-bg: #429E94;
    --nx-role-primary-fg: #F2F5F7;
    --nx-role-primary-hover: #57B2A8;
    --nx-role-primary-pressed: #308C82;
    --nx-role-primary-border: #66C2B8;
    --nx-role-primary-disabled: #638884;
    --nx-role-common-bg: #3D4047;
    --nx-role-common-fg: #E0E3E6;
    --nx-role-common-hover: #52545C;
    --nx-role-common-pressed: #2B2E36;
    --nx-role-common-border: #61636B;
    --nx-role-common-disabled: #3A3B3E;
    --nx-role-alarm-bg: #BD5252;
    --nx-role-alarm-fg: #F2F5F7;
    --nx-role-alarm-hover: #D16666;
    --nx-role-alarm-pressed: #AB4040;
    --nx-role-alarm-border: #E07575;
    --nx-role-alarm-disabled: #8B6060;
    --nx-role-success-bg: #4C9E80;
    --nx-role-success-fg: #F2F5F7;
    --nx-role-success-hover: #61B294;
    --nx-role-success-pressed: #3B8C6E;
    --nx-role-success-border: #70C2A3;
    --nx-role-success-disabled: #68887C;
    --nx-role-warning-bg: #CCA34C;
    --nx-role-warning-fg: #14171A;
    --nx-role-warning-hover: #E0B861;
    --nx-role-warning-pressed: #BA913B;
    --nx-role-warning-border: #F0C770;
    --nx-role-warning-disabled: #B09F7D;
    --nx-role-info-bg: #528F9E;
    --nx-role-info-fg: #F2F5F7;
    --nx-role-info-hover: #66A3B2;
    --nx-role-info-pressed: #407D8C;
    --nx-role-info-border: #75B3C2;
    --nx-role-info-disabled: #678086;
    --nx-role-muted-bg: #4C4F57;
    --nx-role-muted-fg: #9499A1;
    --nx-role-muted-hover: #61636B;
    --nx-role-muted-pressed: #3B3D45;
    --nx-role-muted-border: #70737A;
    --nx-role-muted-disabled: #494A4D;
    --nx-role-ghost-bg: rgba(102, 199, 184, 0);
    --nx-role-ghost-fg: #66C7B8;
    --nx-role-ghost-hover: rgba(102, 199, 184, 0.14);
    --nx-role-ghost-pressed: rgba(102, 199, 184, 0.24);
    --nx-role-ghost-border: #66C7B8;
    --nx-role-ghost-disabled: rgba(102, 199, 184, 0.3);

    --nx-r-s: 2px;
    --nx-r-m: 4px;
    --nx-r-l: 6px;
    --nx-title-spacing: 0px;
}
