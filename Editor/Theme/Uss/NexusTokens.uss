/* Сгенерировано из NexusToken — не править руками. Exerussus/Nexus/Dev/Regenerate theme USS.
   Классы-токены: nx-fg--<token> (текст), nx-bg--<token> (фон), nx-bd--<token> (рамка). */

.nx-fg--bg-hard { color: var(--nx-bg-hard); }
.nx-bg--bg-hard { background-color: var(--nx-bg-hard); }
.nx-bd--bg-hard { border-color: var(--nx-bg-hard); }

