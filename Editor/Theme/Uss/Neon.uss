/* Сгенерировано из NexusPalette «Neon» — не править руками.
   Exerussus/Nexus/Dev/Regenerate theme USS. */

.nx-root {
    --nx-bg-hard: #0A0E14;
    --nx-bg-soft: #0F151E;
    --nx-bg-raised: #151D29;
    --nx-text-normal: #D2DCE6;
    --nx-text-dim: #8495A6;
    --nx-border: #1F2C3B;
    --nx-accent: #4CC3D9;
    --nx-selection: #10262E;
    --nx-hover: #122030;
    --nx-pressed: #18293C;
    --nx-ok: #5ED6A0;
    --nx-warning: #E8BE6A;
    --nx-error: #E86A7E;
    --nx-muted: #4C5D70;
    --nx-orphan: #D9925A;
    --nx-surface-hover: #122030;
    --nx-divider: #172230;
    --nx-accent-hover: #6AD3E6;
    --nx-accent-pressed: #2E8DA1;
    --nx-accent-soft: #10262E;
    --nx-on-accent: #031418;
    --nx-ok-soft: #0E2620;
    --nx-warning-soft: #29220F;
    --nx-error-soft: #2A141A;
    --nx-text-faint: #4C5D70;
    --nx-focus: #4CC3D9;
    --nx-bg-inset: #06090D;
    --nx-accent-text: #8AD4E3;
    --nx-code: #B3E3C6;
    --nx-tag-amber: #E8BE6A;
    --nx-tag-amber-soft: #29220F;
    --nx-tag-green: #5ED6A0;
    --nx-tag-green-soft: #0E2620;
    --nx-tag-blue: #7FAEE6;
    --nx-tag-blue-soft: #0F1F38;
    --nx-tag-violet: #C99BE8;
    --nx-tag-violet-soft: #251A30;
    --nx-glow: rgba(76, 195, 217, 0.22);
    --nx-bracket: #4CC3D9;
    --nx-grid: rgba(76, 195, 217, 0.018);

    --nx-role-primary-bg: #3AA8BF;
    --nx-role-primary-fg: #031418;
    --nx-role-primary-hover: #4CC3D9;
    --nx-role-primary-pressed: #2E8DA1;
    --nx-role-primary-border: #3AA8BF;
    --nx-role-primary-disabled: #6A969F;
    --nx-role-common-bg: #132131;
    --nx-role-common-fg: #D2DCE6;
    --nx-role-common-hover: #1A2D42;
    --nx-role-common-pressed: #18293C;
    --nx-role-common-border: #1F2C3B;
    --nx-role-common-disabled: #1A2026;
    --nx-role-alarm-bg: #C9506A;
    --nx-role-alarm-fg: #FFFFFF;
    --nx-role-alarm-hover: #DD647E;
    --nx-role-alarm-pressed: #B73E58;
    --nx-role-alarm-border: #ED748E;
    --nx-role-alarm-disabled: #93626D;
    --nx-role-success-bg: #2FA37A;
    --nx-role-success-fg: #FFFFFF;
    --nx-role-success-hover: #43B78E;
    --nx-role-success-pressed: #1D9168;
    --nx-role-success-border: #53C79E;
    --nx-role-success-disabled: #588676;
    --nx-role-warning-bg: #DDB25E;
    --nx-role-warning-fg: #1B1B1B;
    --nx-role-warning-hover: #F1C672;
    --nx-role-warning-pressed: #CBA04C;
    --nx-role-warning-border: #FFD682;
    --nx-role-warning-disabled: #C0AF8D;
    --nx-role-info-bg: #4F86D6;
    --nx-role-info-fg: #FFFFFF;
    --nx-role-info-hover: #639AEA;
    --nx-role-info-pressed: #3D74C4;
    --nx-role-info-border: #73AAFA;
    --nx-role-info-disabled: #677D9D;
    --nx-role-muted-bg: #132131;
    --nx-role-muted-fg: #8495A6;
    --nx-role-muted-hover: #1A2D42;
    --nx-role-muted-pressed: #18293C;
    --nx-role-muted-border: #1F2C3B;
    --nx-role-muted-disabled: #1A2026;
    --nx-role-ghost-bg: rgba(0, 0, 0, 0);
    --nx-role-ghost-fg: #8AD4E3;
    --nx-role-ghost-hover: #10262E;
    --nx-role-ghost-pressed: #15313C;
    --nx-role-ghost-border: #1F2C3B;
    --nx-role-ghost-disabled: rgba(138, 212, 227, 0.3);

    --nx-r-s: 2px;
    --nx-r-m: 3px;
    --nx-r-l: 4px;
    --nx-title-spacing: 1.5px;
}
